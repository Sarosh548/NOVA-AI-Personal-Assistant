# NOVA local Docker Compose configuration.
# Copy this file to .env and replace provider credentials with your
# own development values. .env is ignored by Git.

POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000

GROQ_API_KEY=

# Optional for live web research development.
TAVILY_API_KEY=

# Optional for realtime voice development.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional for email notifications and account verification.
# Set notification default channel to email only when SMTP is configured.
NOTIFICATION_DEFAULT_CHANNEL=console
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM_ADDRESS=
NOTIFICATION_SMTP_STARTTLS=true
NOTIFICATION_SMTP_USE_SSL=false
NOTIFICATION_SMTP_TIMEOUT_SECONDS=10

# Optional for Google Calendar OAuth development.
# The redirect URI must exactly match the URI registered in Google Cloud.
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/calendar/callback
CALENDAR_GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events

# Optional for calendar/provider token encryption.
# Must be a valid Fernet key when integration token encryption is used.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
