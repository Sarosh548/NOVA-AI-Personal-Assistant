# NOVA local Docker Compose configuration.
# Copy this file to .env and replace provider credentials with your
# own development values. .env is ignored by Git.

POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000

GROQ_API_KEY=

# Free-tier native speech-to-speech provider for the NOVA Voice surface.
# Get a key from https://aistudio.google.com/ and keep it server-side.
# The app creates a short-lived, single-use token; never put this in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# Local WebRTC voice is self-hosted by scripts/nova_startup.py using Docker.
# Leave these blank for the loopback-only local LiveKit development server.
# For a hosted LiveKit server, set all three values to that server's credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NOVA_LIVEKIT_AGENT_NAME=nova-voice

# Optional paid provider; retained only for explicit provider testing.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Optional for live web research development.
TAVILY_API_KEY=

# Optional for realtime voice development.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional dedicated Urdu (Pakistan) TTS using Azure AI Speech.
# Create a Speech resource and set its key and region to enable Urdu audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_URDU_VOICE=ur-PK-UzmaNeural
AZURE_SPEECH_URDU_RATE=-20%
AZURE_SPEECH_HINDI_VOICE=hi-IN-Priya:MAI-Voice-2
AZURE_SPEECH_HINDI_RATE=0%

# Optional for Google Calendar OAuth development.
# The redirect URI must exactly match the URI registered in Google Cloud.
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/calendar/callback
CALENDAR_GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events

# Optional for calendar/provider token encryption.
# Must be a valid Fernet key when integration token encryption is used.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Optional local Windows desktop control. Disabled by default.
# Enable only on a trusted personal device; never expose unrestricted OS control via a public server.
# When using scripts/nova_startup.py, also set NOVA_DESKTOP_CONTROL_ENABLED in the current user's Windows environment.
NOVA_DESKTOP_CONTROL_ENABLED=false

# Exact HTTPS origin served by GitHub Pages.
NOVA_FRONTEND_ORIGIN=https://sarosh548.github.io
API_CORS_ALLOWED_ORIGINS=https://sarosh548.github.io
